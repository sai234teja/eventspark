# ==============================================================================
# EventSpark v2.1 Production Environment Variables
# ==============================================================================
# IMPORTANT: Never commit actual secrets to version control.
# Copy this file to .env.local and populate with your credentials.

# ------------------------------------------------------------------------------
# Core Application
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------------------------
# Razorpay (Commerce)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Authentication (Google OAuth)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Communications
# ------------------------------------------------------------------------------
# Resend (Email Provider)
RESEND_API_KEY=YOUR_RESEND_API_KEY
# MSG91 (SMS Provider)
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY

# ------------------------------------------------------------------------------
# Security & Rate Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="YOUR_UPSTASH_REDIS_REST_URL"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# ------------------------------------------------------------------------------
# Telemetry & Maps
# ------------------------------------------------------------------------------
SENTRY_DSN=YOUR_SENTRY_DSN
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

 